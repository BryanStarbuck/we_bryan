{"i":7,"start_s":31.98,"end_s":32.36,"speaker":null,"speaker_conf":"none","speaker_cause":"no_turn_overlap","overlap":false,"low_conf":false,"text":"It says"}
{"i":8,"start_s":32.46,"end_s":50.16,"speaker":"SPEAKER_01","speaker_conf":"low","overlap":false,"low_conf":false,"text":"talking point number five, health care denial horror stories from Canada and other countries do resonate, but you have to humanize them. You'll notice we recommend the phrase \"government takeover\" rather than \"government run\" or \"government controlled.\" Why? Because \"government takeover\" sounds even scarier."}
{"i":9,"start_s":50.17,"end_s":50.67,"speaker":null,"speaker_conf":"none","speaker_cause":"no_turn_overlap","overlap":false,"low_conf":false,"text":"So what"}
