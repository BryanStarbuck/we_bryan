{"i":22,"start_s":113.25,"end_s":113.7,"speaker":null,"speaker_conf":"none","speaker_cause":"no_turn_overlap","overlap":false,"low_conf":false,"text":"And what"}
{"i":23,"start_s":113.75,"end_s":117.68,"speaker":"SPEAKER_01","speaker_conf":"high","overlap":false,"low_conf":false,"text":"have we heard on the floor of this chamber from the minority leader?"}
