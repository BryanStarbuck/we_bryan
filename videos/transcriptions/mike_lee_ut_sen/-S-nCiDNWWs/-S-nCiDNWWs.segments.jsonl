ker_undetermined","start_s":500.68,"end_s":500.93,"segment_i":103,"cause":"no_turn_overlap"},{"kind":"speaker_undetermined","start_s":506.22,"end_s":506.85,"segment_i":105,"cause":"no_turn_overlap"},{"kind":"speaker_undetermined","start_s":512.85,"end_s":513.79,"segment_i":108,"cause":"no_turn_overlap"},{"kind":"speaker_undetermined","start_s":526.04,"end_s":526.71,"segment_i":111,"cause":"no_turn_overlap"},{"kind":"speaker_undetermined","start_s":528.66,"end_s":529.04,"segment_i":113,"cause":"no_turn_overlap"},{"kind":"speaker_undetermined","start_s":535.73,"end_s":536.26,"segment_i":115,"cause":"no_turn_overlap"},{"kind":"speaker_undetermined","start_s":537.56,"end_s":538.07,"segment_i":117,"cause":"no_turn_overlap"},{"kind":"speaker_undetermined","start_s":557.46,"end_s":557.74,"segment_i":122,"cause":"no_turn_overlap"},{"kind":"speaker_undetermined","start_s":560.42,"end_s":561.25,"segment_i":124,"cause":"no_turn_overlap"},{"kind":"speaker_undetermined","start_s":579.3,"end_s":580.7,"segment_i":127,"cause":"no_turn_overlap"},{"kind":"speaker_undetermined","start_s":597.28,"end_s":597.72,"segment_i":131,"cause":"no_turn_overlap"},{"kind":"speaker_undetermined","start_s":602.54,"end_s":603.09,"segment_i":133,"cause":"no_turn_overlap"},{"kind":"speaker_undetermined","start_s":611.63,"end_s":612.34,"segment_i":136,"cause":"no_turn_overlap"},{"kind":"speaker_undetermined","start_s":612.29,"end_s":612.52,"segment_i":137,"cause":"no_turn_overlap"},{"kind":"speaker_undetermined","start_s":640.49,"end_s":640.91,"segment_i":141,"cause":"no_turn_overlap"},{"kind":"speaker_undetermined","start_s":640.9,"end_s":641.1,"segment_i":142,"cause":"no_turn_overlap"},{"kind":"speaker_undetermined","start_s":644.96,"end_s":645.73,"segment_i":144,"cause":"no_turn_overlap"},{"kind":"speaker_undetermined","start_s":655.6,"end_s":656.2,"segment_i":147,"cause":"no_turn_overlap"},{"kind":"speaker_undetermined","start_s":665.22,"end_s":665.7,"segment_i":150,"cause":"no_turn_overlap"},{"kind":"speaker_undetermined","start_s":672.38,"end_s":673.32,"segment_i":152,"cause":"no_turn_overlap"}],"enriched_from":null,"header":true}
{"i":0,"start_s":0.96,"end_s":0.97,"speaker":null,"speaker_conf":"none","speaker_cause":"no_turn_overlap","overlap":false,"low_conf":false,"text":"Mr."}
{"i":1,"start_s":1.01,"end_s":12.98,"speaker":"SPEAKER_00","speaker_conf":"low","overlap":false,"low_conf":false,"text":"President, I stood before this body in March of this year to protest our country's unconstitutional intervention in Saudi Arabia's bloody war"}
{"i":2,"start_s":13.19,"end_s":14.56,"speaker":null,"speaker_conf":"none","speaker_cause":"no_turn_overlap","overlap":false,"low_conf":false,"text":"in Yemen."}
{"i":3,"start_s":14.61,"end_s":25.19,"speaker":"SPEAKER_00","speaker_conf":"high","overlap":false,"low_conf":false,"text":"I was proud to stand with my colleagues, Senator Sanders and Senator Murphy, to file a discharge motion of our resolution, S.J. Res. 54, that"}
{"i":4,"start_s":25.2,"end_s":26.03,"speaker":null,"speaker_conf":"none","speaker_cause":"no_turn_overlap","overlap":false,"low_conf":false,"text":"would remove"}
{"i":5,"start_s":26.13,"end_s":28.21,"speaker":"SPEAKER_00","speaker_conf":"high","overlap":false,"low_conf":false,"text":"U.S. Armed Forces from"}
{"i":6,"start_s":28.77,"end_s":29.12,"speaker":null,"speaker_conf":"none","speaker_cause":"no_turn_overlap","overlap":false,"low_conf":false,"text":"Yemen."}
{"i":7,"start_s":29.1,"end_s":29.73,"speaker":null,"speaker_conf":"none","speaker_cause":"no_turn_overlap","overlap":false,"low_conf":false,"text":"At that"}
{"i":8,"start_s":29.84,"end_s":42.3,"speaker":"SPEAKER_02","speaker_conf":"low","overlap":false,"low_conf":false,"text":"time, members of the Foreign Relations Committee requested additional time to study the issue and to debate the resolution in the Foreign Relations Committee. The chairman of that committee,"}
{"i":9,"start_s":42.3,"end_s":46.23,"speaker":"SPEAKER_03","speaker_conf":"low","overlap":false,"low_conf":false,"text":"my friend and colleague from Tennessee, Senator"}
{"i":10,"start_s":46.23,"end_s":46.84,"speaker":null,"speaker_conf":"none","speaker_cause":"no_turn_overlap","overlap":false,"low_conf":false,"text":"Corker,"}
{"i":11,"start_s":46.84,"end_s":58.28,"speaker":"SPEAKER_00","speaker_conf":"high","overlap":false,"low_conf":false,"text":"requested this with the commitment to, quote, bring forth legislation to actually appropriately deal with many of the issues relative to Yemen, Saudi Arabia, and ourselves."}
{"i":12,"start_s":58.45,"end_s":59.87,"speaker":"SPEAKER_00","speaker_conf":"high","overlap":false,"low_conf":false,"text":"Close quote."}
{"i":13,"start_s":60.05,"end_s":60.06,"speaker":null,"speaker_conf":"none","speaker_cause":"no_turn_overlap","overlap":false,"low_conf":false,"text":"So"}
{"i":14,"start_s":60.09,"end_s":75.03,"speaker":"SPEAKER_05","speaker_conf":"low","overlap":false,"low_conf":false,"text":"with that, the Senate voted to table the motion. Now, since then, the committee has held a hearing on this issue and introduced a separate bipartisan bill to address it. But no further action has been taken. And so today,"}
{"i":15,"start_s":75.03,"end_s":83.88,"speaker":"SPEAKER_06","speaker_conf":"high","overlap":false,"low_conf":false,"text":"eight months later, the bloodshed continues, still abetted by the United States, even amidst further revelations of"}
{"i":16,"start_s":83.97,"end_s":85.56,"speaker":"SPEAKER_02","speaker_conf":"high","overlap":false,"low_conf":false,"text":"Saudi depravity."}
{"i":17,"start_s":85.52,"end_s":85.98,"speaker":null,"speaker_conf":"none","speaker_cause":"no_turn_overlap","overlap":false,"low_conf":false,"text":"It is"}
{"i":18,"start_s":86.24,"end_s":94.88,"speaker":"SPEAKER_02","speaker_conf":"high","overlap":false,"low_conf":false,"text":"long past overdue that Congress remove US forces from Yemen, as recent circumstances only confirm. Today, we"}
{"i":19,"start_s":94.88,"end_s":97.26,"speaker":"SPEAKER_05","speaker_conf":"low","overlap":false,"low_conf":false,"text":"have the chance to remedy our course of action"}
{"i":20,"start_s":97.26,"end_s":103.28,"speaker":"SPEAKER_06","speaker_conf":"high","overlap":false,"low_conf":false,"text":"and to do what the Constitution and justice demand. The"}
{"i":21,"start_s":103.72,"end_s":105.45,"speaker":"SPEAKER_05","speaker_conf":"high","overlap":false,"low_conf":false,"text":"situation in Yemen"}
{"i":22,"start_s":105.45,"end_s":106.67,"speaker":null,"speaker_conf":"none","speaker_cause":"no_turn_overlap","overlap":false,"low_conf":false,"text":"is dire."}
{"i":23,"start_s":106.7,"end_s":113.42,"speaker":"SPEAKER_05","speaker_conf":"high","overlap":false,"low_conf":false,"text":"The war has killed tens of thousands of innocent civilians, human beings lest we forget,"}
{"i":24,"start_s":113.64,"end_s":121.81,"speaker":"SPEAKER_00","speaker_conf":"low","overlap":false,"low_conf":false,"text":"each one of them possessing immeasurable dignity and inherent worth. It has created refugees,"}
{"i":25,"start_s":121.81,"end_s":128.73,"speaker":"SPEAKER_02","speaker_conf":"high","overlap":false,"low_conf":false,"text":"orphans, widows, and it's also displaced countless families. The"}
{"i":26,"start_s":128.73,"end_s":141.25,"speaker":"SPEAKER_06","speaker_conf":"high","overlap":false,"low_conf":false,"text":"numbers and the inhumanity are staggering, nothing short of it. Since 2015, more than 10,000 civilians have died, and 40,000 have been wounded."}
{"i":27,"start_s":141.2,"end_s":141.48,"speaker":null,"speaker_conf":"none","speaker_cause":"no_turn_overlap","overlap":false,"low_conf":false,"text":"In an"}
{"i":28,"start_s":141.74,"end_s":151.15,"speaker":"SPEAKER_06","speaker_conf":"low","overlap":false,"low_conf":false,"text":"attack just a few months ago, a bomb was dropped on a school bus that killed 40 young boys who were on a school trip and wounded another"}
{"i":29,"start_s":151.18,"end_s":151.88,"speaker":null,"speaker_conf":"none","speaker_cause":"no_turn_overlap","overlap":false,"low_conf":false,"text":"56"}
{"i":30,"start_s":151.88,"end_s":158.59,"speaker":"SPEAKER_00","speaker_conf":"low","overlap":false,"low_conf":false,"text":"children. But what few Americans knew until recently is that the U.S. military has actually"}
{"i":31,"start_s":159.1,"end_s":167.82,"speaker":"SPEAKER_06","speaker_conf":"high","overlap":false,"low_conf":false,"text":"been making the crisis worse by helping one side bomb these innocent civilians."}
{"i":32,"start_s":168.04,"end_s":168.05,"speaker":null,"speaker_conf":"none","speaker_cause":"no_turn_overlap","overlap":false,"low_conf":false,"text":"How"}
{"i":33,"start_s":168.05,"end_s":173.85,"speaker":"SPEAKER_06","speaker_conf":"high","overlap":false,"low_conf":false,"text":"did we get entangled in this crisis to begin with? Well in March of 2015,"}
{"i":34,"start_s":173.85,"end_s":181.96,"speaker":"SPEAKER_05","speaker_conf":"high","overlap":false,"low_conf":false,"text":"Saudi Arabia launched a war against the Houthi rebels shortly after the Houthis ousted the Saudi-backed government in the capital city"}
{"i":35,"start_s":182.1,"end_s":182.79,"speaker":null,"speaker_conf":"none","speaker_cause":"no_turn_overlap","overlap":false,"low_conf":false,"text":"of Sana'a."}
{"i":36,"start_s":182.95,"end_s":185.88,"speaker":"SPEAKER_05","speaker_conf":"high","overlap":false,"low_conf":false,"text":"The Obama administration, without consulting Congress,"}
{"i":37,"start_s":185.88,"end_s":186.04,"speaker":null,"speaker_conf":"none","speaker_cause":"no_turn_overlap","overlap":false,"low_conf":false,"text":"quickly"}
{"i":38,"start_s":186.81,"end_s":194.81,"speaker":"SPEAKER_06","speaker_conf":"high","overlap":false,"low_conf":false,"text":"authorized U.S. military forces to provide logistical and intelligence support to the Saudi-led coalition."}
{"i":39,"start_s":194.77,"end_s":200.66,"speaker":"SPEAKER_00","speaker_conf":"high","overlap":false,"low_conf":false,"text":"U.S. military support has continued since then, including mid-air refueling,"}
{"i":40,"start_s":200.68,"end_s":216.23,"speaker":"SPEAKER_03","speaker_conf":"low","overlap":false,"low_conf":false,"text":"surveillance, reconnaissance information, and target selection assistance. In other words, we've been supporting and actively participating in the activities of war in Yemen. But"}
{"i":41,"start_s":216.6,"end_s":217.7,"speaker":null,"speaker_conf":"none","speaker_cause":"no_turn_overlap","overlap":false,"low_conf":false,"text":"Article I, Section 8 of"}
{"i":42,"start_s":217.9,"end_s":223.95,"speaker":"SPEAKER_06","speaker_conf":"low","overlap":false,"low_conf":false,"text":"the Constitution states that Congress shall have the power to declare war. Congress."}
{"i":43,"start_s":224.53,"end_s":224.79,"speaker":null,"speaker_conf":"none","speaker_cause":"no_turn_overlap","overlap":false,"low_conf":false,"text":"Not"}
{"i":44,"start_s":224.92,"end_s":238.88,"speaker":"SPEAKER_06","speaker_conf":"high","overlap":false,"low_conf":false,"text":"the president, not the Pentagon, not someone else in the executive branch. Not any other part of government, but Congress. The founders could not have been any clearer about this. And they did so,"}
{"i":45,"start_s":238.88,"end_s":239.09,"speaker":null,"speaker_conf":"none","speaker_cause":"no_turn_overlap","overlap":false,"low_conf":false,"text":"Mr."}
{"i":46,"start_s":239.41,"end_s":250.98,"speaker":"SPEAKER_05","speaker_conf":"low","overlap":false,"low_conf":false,"text":"President, with very good reason. The founders set up our system of government in such a way as to protect the people from the dangers associated with the excessive accumulation of power in the"}
{"i":47,"start_s":251.08,"end_s":252.81,"speaker":"SPEAKER_03","speaker_conf":"high","overlap":false,"low_conf":false,"text":"hands of the few."}
{"i":48,"start_s":252.79,"end_s":253.44,"speaker":null,"speaker_conf":"none","speaker_cause":"no_turn_overlap","overlap":false,"low_conf":false,"text":"We know"}
{"i":49,"start_s":253.5,"end_s":253.86,"speaker":"SPEAKER_03","speaker_conf":"high","overlap":false,"low_conf":false,"text":"from"}
{"i":50,"start_s":253.86,"end_s":255.02,"speaker":"SPEAKER_06","speaker_conf":"high","overlap":false,"low_conf":true,"text":"experience,"}
{"i":51,"start_s":255.02,"end_s":256.54,"speaker":null,"speaker_conf":"none","speaker_cause":"no_turn_overlap","overlap":false,"low_conf":false,"text":"and we"}
{"i":52,"start_s":256.83,"end_s":281.58,"speaker":"SPEAKER_06","speaker_conf":"low","overlap":false,"low_conf":false,"text":"knew then from our young nation's experience under British rule that bad things happen, especially at a national level, when too few people exercise too much power and that power goes unchecked. And nowhere is this more evident than in the case of the power to declare war. So the founders placed that power squarely in the legislative branch."}
{"i":53,"start_s":281.55,"end_s":281.78,"speaker":null,"speaker_conf":"none","speaker_cause":"no_turn_overlap","overlap":false,"low_conf":true,"text":"The"}
{"i":54,"start_s":281.88,"end_s":285.6,"speaker":"SPEAKER_06","speaker_conf":"high","overlap":false,"low_conf":false,"text":"branch where honest, open, and public debate is supposed to happen,"}
{"i":55,"start_s":285.6,"end_s":286.31,"speaker":null,"speaker_conf":"none","speaker_cause":"no_turn_overlap","overlap":false,"low_conf":false,"text":"and the"}
{"i":56,"start_s":286.44,"end_s":290.22,"speaker":"SPEAKER_06","speaker_conf":"high","overlap":false,"low_conf":false,"text":"branch that is held most accountable to the people through elections,"}
{"i":57,"start_s":290.3,"end_s":290.6,"speaker":null,"speaker_conf":"none","speaker_cause":"no_turn_overlap","overlap":false,"low_conf":false,"text":"at the"}
{"i":58,"start_s":290.6,"end_s":296.64,"speaker":"SPEAKER_06","speaker_conf":"low","overlap":false,"low_conf":false,"text":"most regular intervals. As Alexander Hamilton pointed out in Federalist's paper number"}
{"i":59,"start_s":297.02,"end_s":305.53,"speaker":"SPEAKER_05","speaker_conf":"low","overlap":false,"low_conf":false,"text":"69, this power would not be exercised by the executive branch so that it would be less likely to be"}
{"i":60,"start_s":305.68,"end_s":310.35,"speaker":"SPEAKER_06","speaker_conf":"low","overlap":false,"low_conf":false,"text":"abused, just like it was when the King of England acted..."}
{"i":61,"start_s":310.53,"end_s":311.09,"speaker":null,"speaker_conf":"none","speaker_cause":"no_turn_overlap","overlap":false,"low_conf":false,"text":"in and of"}
{"i":62,"start_s":311.11,"end_s":317.01,"speaker":"SPEAKER_06","speaker_conf":"high","overlap":false,"low_conf":false,"text":"himself, by himself, to send his country, and ours for that matter,"}
{"i":63,"start_s":317.56,"end_s":318.29,"speaker":null,"speaker_conf":"none","speaker_cause":"no_turn_overlap","overlap":false,"low_conf":false,"text":"into war."}
{"i":64,"start_s":318.53,"end_s":327.98,"speaker":"SPEAKER_06","speaker_conf":"low","overlap":false,"low_conf":false,"text":"Now, some opponents of our resolution claim that our involvement in Yemen is somehow constitutionally justified under the War Powers"}
{"i":65,"start_s":327.98,"end_s":328.3,"speaker":"SPEAKER_10","speaker_conf":"high","overlap":false,"low_conf":false,"text":"Act"}
{"i":66,"start_s":328.56,"end_s":330.36,"speaker":null,"speaker_conf":"none","speaker_cause":"no_turn_overlap","overlap":false,"low_conf":false,"text":"of 1973."}
{"i":67,"start_s":330.57,"end_s":334.45,"speaker":"SPEAKER_11","speaker_conf":"high","overlap":false,"low_conf":false,"text":"This isn't true. Now, it is true that the War Powers"}
{"i":68,"start_s":334.46,"end_s":334.82,"speaker":null,"speaker_conf":"none","speaker_cause":"no_turn_overlap","overlap":false,"low_conf":false,"text":"Act"}
{"i":69,"start_s":335.21,"end_s":343.53,"speaker":"SPEAKER_02","speaker_conf":"high","overlap":false,"low_conf":false,"text":"makes it possible for the executive branch of government acting alone to use armed forces in cases of emergencies"}
{"i":70,"start_s":343.54,"end_s":353.48,"speaker":"SPEAKER_06","speaker_conf":"high","overlap":false,"low_conf":false,"text":"and subject to certain limited defined time constraints. But the conflict in Yemen by no means, in no way, shape,"}
{"i":71,"start_s":353.48,"end_s":353.79,"speaker":null,"speaker_conf":"none","speaker_cause":"no_turn_overlap","overlap":false,"low_conf":false,"text":"or form"}
{"i":72,"start_s":354.28,"end_s":364.44,"speaker":"SPEAKER_06","speaker_conf":"high","overlap":false,"low_conf":false,"text":"constitutes a threat to the safety of American citizens. And our involvement has far surpassed the allotted emergency time constraint. The Houthis,"}
{"i":73,"start_s":364.59,"end_s":386.43,"speaker":"SPEAKER_06","speaker_conf":"low","overlap":false,"low_conf":false,"text":"Well, no friends of ours are a regional rebel group, one that does not itself threaten American national security. In fact, the longer we fight against them, the more reason we give them to hate America and embrace the opportunists who are our true enemy in the region are wrong."}
{"i":74,"start_s":386.63,"end_s":386.64,"speaker":null,"speaker_conf":"none","speaker_cause":"no_turn_overlap","overlap":false,"low_conf":false,"text":"The"}
{"i":75,"start_s":386.65,"end_s":394.02,"speaker":"SPEAKER_03","speaker_conf":"low","overlap":false,"low_conf":false,"text":"more we prolong the activities that destabilize the region, the longer we harm our own interests in terms of trade,"}
{"i":76,"start_s":394.35,"end_s":394.36,"speaker":null,"speaker_conf":"none","speaker_cause":"no_turn_overlap","overlap":false,"low_conf":false,"text":"and"}
{"i":77,"start_s":394.37,"end_s":394.79,"speaker":"SPEAKER_03","speaker_conf":"high","overlap":false,"low_conf":false,"text":"broader"}
{"i":78,"start_s":395.3,"end_s":397.13,"speaker":"SPEAKER_05","speaker_conf":"high","overlap":false,"low_conf":false,"text":"regional security."}
{"i":79,"start_s":397.79,"end_s":398.14,"speaker":null,"speaker_conf":"none","speaker_cause":"no_turn_overlap","overlap":false,"low_conf":false,"text":"The War"}
{"i":80,"start_s":398.72,"end_s":411.1,"speaker":"SPEAKER_05","speaker_conf":"low","overlap":false,"low_conf":false,"text":"Powers Act also states that the assignment of U.S. armed forces to coordinate or participate in hostilities of a foreign country constitutes a conflict of war."}
{"i":81,"start_s":411.47,"end_s":411.83,"speaker":null,"speaker_conf":"none","speaker_cause":"no_turn_overlap","overlap":false,"low_conf":false,"text":"And some"}
{"i":82,"start_s":412.4,"end_s":415.14,"speaker":"SPEAKER_05","speaker_conf":"low","overlap":false,"low_conf":false,"text":"have argued that we have"}
{"i":83,"start_s":415.14,"end_s":416.82,"speaker":"SPEAKER_06","speaker_conf":"high","overlap":false,"low_conf":false,"text":"not been engaging in hostilities"}
{"i":84,"start_s":417.38,"end_s":417.39,"speaker":null,"speaker_conf":"none","speaker_cause":"no_turn_overlap","overlap":false,"low_conf":false,"text":"and"}
{"i":85,"start_s":417.4,"end_s":420.02,"speaker":"SPEAKER_14","speaker_conf":"high","overlap":false,"low_conf":false,"text":"therefore have not violated the War Powers"}
{"i":86,"start_s":420.6,"end_s":420.62,"speaker":null,"speaker_conf":"none","speaker_cause":"no_turn_overlap","overlap":false,"low_conf":false,"text":"Act."}
{"i":87,"start_s":420.9,"end_s":420.91,"speaker":null,"speaker_conf":"none","speaker_cause":"no_turn_overlap","overlap":false,"low_conf":false,"text":"But"}
{"i":88,"start_s":420.94,"end_s":425.1,"speaker":"SPEAKER_14","speaker_conf":"low","overlap":false,"low_conf":false,"text":"this claim, too, falls flat on its face. We've"}
{"i":89,"start_s":425.14,"end_s":440.11,"speaker":"SPEAKER_06","speaker_conf":"low","overlap":false,"low_conf":false,"text":"specifically aided the Saudi coalition with mid-air refueling and target selection assistance. Or, as Defense Secretary Jim Mattis himself said in December of 2017, our military is helping the Saudis \"make certain they hit"}
{"i":90,"start_s":440.11,"end_s":446.13,"speaker":"SPEAKER_14","speaker_conf":"high","overlap":false,"low_conf":false,"text":"the right thing.\" In other words, we're helping a foreign power bomb its adversaries."}
{"i":91,"start_s":446.08,"end_s":451.05,"speaker":"SPEAKER_14","speaker_conf":"high","overlap":false,"low_conf":false,"text":"If that doesn't constitute hostilities, I don't know what"}
{"i":92,"start_s":451.37,"end_s":452.7,"speaker":null,"speaker_conf":"none","speaker_cause":"no_turn_overlap","overlap":false,"low_conf":false,"text":"does."}
{"i":93,"start_s":452.92,"end_s":461.49,"speaker":"SPEAKER_02","speaker_conf":"low","overlap":false,"low_conf":false,"text":"Now, finally, some critics say that this resolution would somehow hurt our efforts to combat terrorism in the region, specifically"}
{"i":94,"start_s":461.49,"end_s":466.92,"speaker":"SPEAKER_03","speaker_conf":"low","overlap":false,"low_conf":false,"text":"al-Qaeda and ISIS. However, the resolution explicitly states that it would not impede"}
{"i":95,"start_s":467.03,"end_s":467.04,"speaker":null,"speaker_conf":"none","speaker_cause":"no_turn_overlap","overlap":false,"low_conf":false,"text":"the"}
{"i":96,"start_s":467.2,"end_s":472.2,"speaker":"SPEAKER_06","speaker_conf":"high","overlap":false,"low_conf":false,"text":"military's ability to fight these terror groups. In fact, U.S. involvement in Yemen"}
{"i":97,"start_s":472.41,"end_s":472.42,"speaker":null,"speaker_conf":"none","speaker_cause":"no_turn_overlap","overlap":false,"low_conf":false,"text":"has"}
{"i":98,"start_s":472.43,"end_s":476.91,"speaker":"SPEAKER_06","speaker_conf":"low","overlap":false,"low_conf":false,"text":"arguably undermined the effort against al-Qaeda's affiliates. The State"}
{"i":99,"start_s":476.97,"end_s":488.28,"speaker":"SPEAKER_05","speaker_conf":"low","overlap":false,"low_conf":false,"text":"Department's country reports on terrorism for 2016 found that the conflict between the Saudi-led forces and the Houthi insurgents has actually helped al-Qaeda in the Arabian"}
{"i":100,"start_s":488.41,"end_s":494.51,"speaker":"SPEAKER_06","speaker_conf":"low","overlap":false,"low_conf":false,"text":"Peninsula and ISIS's Yemen branch to deepen their inroads across much of"}
{"i":101,"start_s":494.54,"end_s":495.95,"speaker":null,"speaker_conf":"none","speaker_cause":"no_turn_overlap","overlap":false,"low_conf":false,"text":"the country."}
{"i":102,"start_s":495.95,"end_s":500.62,"speaker":"SPEAKER_06","speaker_conf":"high","overlap":false,"low_conf":false,"text":"It appears that our involvement in Yemen accomplishes no good at"}
{"i":103,"start_s":500.68,"end_s":500.93,"speaker":null,"speaker_conf":"none","speaker_cause":"no_turn_overlap","overlap":false,"low_conf":false,"text":"all."}
{"i":104,"start_s":501.22,"end_s":505.88,"speaker":"SPEAKER_06","speaker_conf":"low","overlap":false,"low_conf":false,"text":"only harm, and serious consequential harm at that."}
{"i":105,"start_s":506.22,"end_s":506.85,"speaker":null,"speaker_conf":"none","speaker_cause":"no_turn_overlap","overlap":false,"low_conf":false,"text":"The situation"}
{"i":106,"start_s":508.01,"end_s":510.93,"speaker":"SPEAKER_06","speaker_conf":"high","overlap":false,"low_conf":false,"text":"in Yemen now poses"}
{"i":107,"start_s":511.01,"end_s":512.54,"speaker":"SPEAKER_00","speaker_conf":"high","overlap":false,"low_conf":false,"text":"a true humanitarian crisis."}
{"i":108,"start_s":512.85,"end_s":513.79,"speaker":null,"speaker_conf":"none","speaker_cause":"no_turn_overlap","overlap":false,"low_conf":false,"text":"The country is"}
{"i":109,"start_s":513.79,"end_s":519.73,"speaker":"SPEAKER_00","speaker_conf":"low","overlap":false,"low_conf":false,"text":"on the brink of rampant disease and mass starvation. An estimated 15"}
{"i":110,"start_s":519.73,"end_s":525.7,"speaker":"SPEAKER_06","speaker_conf":"high","overlap":false,"low_conf":false,"text":"million people don't have access to clean water and sanitation, and 17 million don't have access to food."}
{"i":111,"start_s":526.04,"end_s":526.71,"speaker":null,"speaker_conf":"none","speaker_cause":"no_turn_overlap","overlap":false,"low_conf":false,"text":"More innocent"}
{"i":112,"start_s":527.83,"end_s":528.66,"speaker":"SPEAKER_06","speaker_conf":"high","overlap":false,"low_conf":false,"text":"lives,"}
{"i":113,"start_s":528.66,"end_s":529.04,"speaker":null,"speaker_conf":"none","speaker_cause":"no_turn_overlap","overlap":false,"low_conf":false,"text":"are"}
{"i":114,"start_s":529.3,"end_s":535.73,"speaker":"SPEAKER_05","speaker_conf":"low","overlap":false,"low_conf":false,"text":"being lost every single day. My position on this has not changed for"}
{"i":115,"start_s":535.73,"end_s":536.26,"speaker":null,"speaker_conf":"none","speaker_cause":"no_turn_overlap","overlap":false,"low_conf":false,"text":"the past"}
{"i":116,"start_s":536.26,"end_s":537.56,"speaker":"SPEAKER_05","speaker_conf":"high","overlap":false,"low_conf":false,"text":"eight months. But"}
{"i":117,"start_s":537.56,"end_s":538.07,"speaker":null,"speaker_conf":"none","speaker_cause":"no_turn_overlap","overlap":false,"low_conf":false,"text":"with the"}
{"i":118,"start_s":538.07,"end_s":539.17,"speaker":"SPEAKER_05","speaker_conf":"high","overlap":false,"low_conf":false,"text":"taking of another"}
{"i":119,"start_s":539.17,"end_s":551.86,"speaker":"SPEAKER_06","speaker_conf":"high","overlap":false,"low_conf":false,"text":"innocent life, that of Jamal Khashoggi, the circumstances have only further deteriorated. Intelligence suggests, despite his repeated denials, that the Crown Prince of"}
{"i":120,"start_s":551.86,"end_s":553.28,"speaker":"SPEAKER_08","speaker_conf":"low","overlap":false,"low_conf":false,"text":"Saudi Arabia himself"}
{"i":121,"start_s":553.32,"end_s":557.17,"speaker":"SPEAKER_05","speaker_conf":"low","overlap":false,"low_conf":false,"text":"ordered the murder. Saudi Arabia's moral depravity"}
{"i":122,"start_s":557.46,"end_s":557.74,"speaker":null,"speaker_conf":"none","speaker_cause":"no_turn_overlap","overlap":false,"low_conf":false,"text":"has"}
{"i":123,"start_s":557.86,"end_s":559.82,"speaker":"SPEAKER_05","speaker_conf":"high","overlap":false,"low_conf":false,"text":"only been made plainer."}
{"i":124,"start_s":560.42,"end_s":561.25,"speaker":null,"speaker_conf":"none","speaker_cause":"no_turn_overlap","overlap":false,"low_conf":false,"text":"This is"}
{"i":125,"start_s":561.25,"end_s":568.11,"speaker":"SPEAKER_05","speaker_conf":"low","overlap":false,"low_conf":false,"text":"not an ally that deserves our support or military intervention on its behalf, especially when"}
{"i":126,"start_s":568.26,"end_s":579.3,"speaker":"SPEAKER_06","speaker_conf":"low","overlap":false,"low_conf":false,"text":"our own security is not itself on the line. On the contrary, to continue supporting them in this war would be bad diplomacy and undermine our very credibility."}
{"i":127,"start_s":579.3,"end_s":580.7,"speaker":null,"speaker_conf":"none","speaker_cause":"no_turn_overlap","overlap":false,"low_conf":false,"text":"No, U.S."}
{"i":128,"start_s":580.7,"end_s":586.52,"speaker":"SPEAKER_06","speaker_conf":"high","overlap":false,"low_conf":false,"text":"intervention in Yemen is unauthorized, unconstitutional,"}
{"i":129,"start_s":586.76,"end_s":593.26,"speaker":"SPEAKER_06","speaker_conf":"low","overlap":false,"low_conf":false,"text":"and immoral. And we must not, we cannot delay voting to end our involvement"}
{"i":130,"start_s":593.59,"end_s":597.02,"speaker":"SPEAKER_05","speaker_conf":"low","overlap":false,"low_conf":false,"text":"and our support of Saudi Arabia any further. If we do,"}
{"i":131,"start_s":597.28,"end_s":597.72,"speaker":null,"speaker_conf":"none","speaker_cause":"no_turn_overlap","overlap":false,"low_conf":false,"text":"we have"}
{"i":132,"start_s":597.72,"end_s":601.54,"speaker":"SPEAKER_05","speaker_conf":"high","overlap":false,"low_conf":false,"text":"ourselves to blame for our country's lost credibility on the world"}
{"i":133,"start_s":602.54,"end_s":603.09,"speaker":null,"speaker_conf":"none","speaker_cause":"no_turn_overlap","overlap":false,"low_conf":false,"text":"stage. And"}
{"i":134,"start_s":603.14,"end_s":610.64,"speaker":"SPEAKER_05","speaker_conf":"low","overlap":false,"low_conf":false,"text":"more importantly, our own consciences will bear the blame for the thousands of lives that will surely continue"}
{"i":135,"start_s":611.21,"end_s":611.62,"speaker":"SPEAKER_02","speaker_conf":"high","overlap":false,"low_conf":false,"text":"to be"}
{"i":136,"start_s":611.63,"end_s":612.34,"speaker":null,"speaker_conf":"none","speaker_cause":"no_turn_overlap","overlap":false,"low_conf":false,"text":"lost."}
{"i":137,"start_s":612.29,"end_s":612.52,"speaker":null,"speaker_conf":"none","speaker_cause":"no_turn_overlap","overlap":false,"low_conf":false,"text":"The"}
{"i":138,"start_s":612.52,"end_s":621.54,"speaker":"SPEAKER_02","speaker_conf":"low","overlap":false,"low_conf":false,"text":"Founding Fathers had incredible wisdom in requiring these issues, issues of American blood and American treasure, to be debated and discussed"}
{"i":139,"start_s":621.78,"end_s":634.89,"speaker":"SPEAKER_06","speaker_conf":"low","overlap":false,"low_conf":false,"text":"between two equal branches of government. They understood that matters of war and alliances must constantly be reconsidered and reevaluated and in an open, honest,"}
{"i":140,"start_s":634.89,"end_s":640.26,"speaker":"SPEAKER_05","speaker_conf":"low","overlap":false,"low_conf":false,"text":"and public manner. That is one of our most solemn duties in this"}
{"i":141,"start_s":640.49,"end_s":640.91,"speaker":null,"speaker_conf":"none","speaker_cause":"no_turn_overlap","overlap":false,"low_conf":false,"text":"body."}
{"i":142,"start_s":640.9,"end_s":641.1,"speaker":null,"speaker_conf":"none","speaker_cause":"no_turn_overlap","overlap":false,"low_conf":false,"text":"And"}
{"i":143,"start_s":641.1,"end_s":644.77,"speaker":"SPEAKER_05","speaker_conf":"high","overlap":false,"low_conf":false,"text":"it's the opportunity that lies squarely before us today. We"}
{"i":144,"start_s":644.96,"end_s":645.73,"speaker":null,"speaker_conf":"none","speaker_cause":"no_turn_overlap","overlap":false,"low_conf":false,"text":"owe it to the"}
{"i":145,"start_s":645.73,"end_s":652.96,"speaker":"SPEAKER_05","speaker_conf":"low","overlap":false,"low_conf":false,"text":"sons and daughters of the American people who put their sons and daughters in harm's way to defend us. We owe it to their parents"}
{"i":146,"start_s":652.96,"end_s":655.5,"speaker":"SPEAKER_06","speaker_conf":"high","overlap":false,"low_conf":false,"text":"and their families. We owe it to ourselves,"}
{"i":147,"start_s":655.6,"end_s":656.2,"speaker":null,"speaker_conf":"none","speaker_cause":"no_turn_overlap","overlap":false,"low_conf":false,"text":"who have"}
{"i":148,"start_s":656.32,"end_s":659.28,"speaker":"SPEAKER_06","speaker_conf":"low","overlap":false,"low_conf":false,"text":"taken an oath to uphold, protect, and"}
{"i":149,"start_s":659.28,"end_s":663.24,"speaker":"SPEAKER_17","speaker_conf":"low","overlap":false,"low_conf":false,"text":"defend the Constitution of the United States."}
{"i":150,"start_s":665.22,"end_s":665.7,"speaker":null,"speaker_conf":"none","speaker_cause":"no_turn_overlap","overlap":false,"low_conf":false,"text":"I urge"}
{"i":151,"start_s":665.7,"end_s":672.06,"speaker":"SPEAKER_17","speaker_conf":"low","overlap":false,"low_conf":false,"text":"my colleagues to vote in favor of the motion to discharge your resolution."}
{"i":152,"start_s":672.38,"end_s":673.32,"speaker":null,"speaker_conf":"none","speaker_cause":"no_turn_overlap","overlap":false,"low_conf":false,"text":"Thank you, Mr."}
{"i":153,"start_s":673.32,"end_s":675.18,"speaker":"SPEAKER_17","speaker_conf":"high","overlap":false,"low_conf":false,"text":"President. I yield the floor."}
